{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sand-worm-labs/tools/schema/tool.schema.json",
  "title": "Tool",
  "type": "object",
  "required": ["tool_id", "g1", "description"],
  "additionalProperties": false,
  "properties": {
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
      "description": "dotted <category>.<name> id, must match the file's own name"
    },
    "g1": { "type": "string", "description": "must match a category_id in categories.yaml" },
    "g2": { "type": "string" },
    "g3": { "type": "string" },
    "g4": { "type": "string" },
    "g5": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "default": "generic" },
    "returns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "type", "required"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "address",
              "address[]",
              "chain",
              "chain[]",
              "select",
              "schema_uid",
              "token_address",
              "event_signature",
              "function_signature",
              "text",
              "number",
              "date",
              "date_range"
            ],
            "description": "must be a type the loaders/frontend field registry actually renders — see loaders/typescript/src/types.ts"
          },
          "required": { "type": "boolean" },
          "default": {},
          "description": {
            "type": "string",
            "description": "help text shown under the field label"
          },
          "placeholder": {
            "type": "string",
            "description": "placeholder text for text/number/address-style inputs"
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string" },
            "description": "keys of other inputs[].key this field's dynamic choices depend on, e.g. for type: event_signature"
          },
          "options": {
            "type": "array",
            "description": "fixed choices for type: select | chain | chain[]",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "string" },
                "icon": { "type": "string", "description": "URL to an icon image for this option" }
              }
            }
          },
          "min": {
            "type": "number",
            "description": "lower bound for type: number"
          },
          "max": {
            "type": "number",
            "description": "upper bound for type: number"
          }
        }
      }
    }
  }
}
